{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "esnext",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "~aispire/external/openai": ["modules/external/openai/src/index.ts"],
      "~aispire/external/openai/server": [
        "modules/external/openai/src/server.ts"
      ],
      "~aispire/common/auth": ["modules/common/auth/src/index.ts"],
      "~aispire/common/auth/server": ["modules/common/auth/src/server.ts"],
      "~aispire/external/supabase": ["modules/external/supabase/src/index.ts"],
      "~aispire/external/supabase/server": [
        "modules/external/supabase/src/server.ts"
      ],
      "~aispire/shared/icons": ["modules/shared/icons/src/index.ts"],
      "~aispire/shared/icons/server": ["modules/shared/icons/src/server.ts"],
      "~aispire/shared/schema": ["modules/shared/schema/src/index.ts"],
      "~aispire/shared/schema/server": ["modules/shared/schema/src/server.ts"],
      "~aispire/shared/ui": ["modules/shared/ui/src/index.ts"],
      "~aispire/shared/ui/server": ["modules/shared/ui/src/server.ts"],
      "~aispire/shared/utils": ["./modules/shared/utils/src/index.ts"],
      "~aispire/shared/utils/server": ["./modules/shared/utils/src/server.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "tmp",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "dist/aispire/**/*"
  ]
}
